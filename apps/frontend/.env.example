# Better Auth
# REQUIRED. Secret used to sign/encrypt auth tokens (min 32 chars).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# OPTIONAL. Base URL of the app (defaults to http://localhost:3000 in dev).
BETTER_AUTH_URL=
# OPTIONAL. SQLite file location (defaults to ./data/app.sqlite).
DATABASE_URL=

# OpenRouter (AI SDK)
# REQUIRED for AI features. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
