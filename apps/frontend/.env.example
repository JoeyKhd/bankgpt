# Better Auth
# REQUIRED. Secret used to sign/encrypt auth tokens (min 32 chars).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# OPTIONAL. Base URL of the app (defaults to http://localhost:3000 in dev).
BETTER_AUTH_URL=
# OPTIONAL. SQLite file location (defaults to ./data/app.sqlite).
DATABASE_URL=

# OpenRouter (AI SDK)
# REQUIRED for AI features. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Automation engine (apps/engine)
# OPTIONAL. Base URL of the automation engine's HTTP API, proxied at
# /api/engine/* (defaults to http://127.0.0.1:4011). The console degrades
# to the stub catalog when the engine is unreachable.
ENGINE_URL=
# OPTIONAL. WebSocket URL of the engine's live-session control channel
# (defaults to ws://127.0.0.1:4011/ws). The BROWSER connects directly — Next
# route handlers cannot proxy WS upgrades. Name only; no secret.
NEXT_PUBLIC_ENGINE_WS_URL=

# SEO / metadata
# OPTIONAL. Public site URL used for canonical URLs, OG tags, sitemap, and
# robots.txt (defaults to https://bankgpt.ai).
NEXT_PUBLIC_SITE_URL=
