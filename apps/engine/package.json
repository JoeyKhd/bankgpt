{
  "name": "engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "discover": "node --env-file-if-exists=.env.local --import tsx src/cli.ts discover",
    "replay": "node --env-file-if-exists=.env.local --import tsx src/cli.ts replay"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.94",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.7",
    "playwright": "^1.63.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  }
}
