# REQUIRED: OpenRouter API key for the discovery loop's model calls.
OPENROUTER_API_KEY=
# OPTIONAL: engine HTTP/WS port (default 4011).
ENGINE_PORT=
# OPTIONAL: engine SQLite path (default data/engine.sqlite).
ENGINE_DB_PATH=
# OPTIONAL: comma-separated URL regexes the agent may reach (replaces the
# default localhost/127.0.0.1 allowlist). Set to ^https?://mockbank(:\d+)?(/|$)
# when the target is the mockbank compose service. Keep it narrow — this is
# the guardrail that stops the agent roaming the open web.
ENGINE_ALLOWED_URL_PATTERNS=
