# Docker Compose environment (docker-compose.yaml reads these).
# Copy to .env and fill in: `cp .env.example .env`

# REQUIRED: better-auth token signing secret (min 32 chars).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# REQUIRED for AI features (frontend chat + engine discovery loop).
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OPTIONAL: host port overrides (defaults match `pnpm dev`: 3000/3001/4011/4010).
# Useful to run the container stack alongside the dev servers.
# FRONTEND_HOST_PORT=3000
# DOCS_HOST_PORT=3001
# ENGINE_HOST_PORT=4011
# MOCKBANK_HOST_PORT=4010

# OPTIONAL: override the browser-facing engine WebSocket URL if you change
# ENGINE_HOST_PORT or serve the stack behind another host.
# NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:4011/ws
