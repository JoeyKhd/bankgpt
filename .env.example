# Docker Compose environment (docker-compose.yaml reads these).
# Copy to .env and fill in: `cp .env.example .env`

# REQUIRED: better-auth token signing secret (min 32 chars).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# REQUIRED for AI features (frontend chat + engine discovery loop).
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Production (Dokploy): set these to your public URLs.
# BETTER_AUTH_URL=https://app.example.com
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# The BROWSER connects to the engine's /ws channel directly, so it needs a
# public URL too (route a domain to the engine's internal port 4011):
# NEXT_PUBLIC_ENGINE_WS_URL=wss://engine.example.com/ws
